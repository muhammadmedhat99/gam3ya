# Copy this file to .env.local and fill in the values.
# Never commit .env.local.

# Supabase project (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Secret key (sb_secret_...). SERVER-ONLY: no NEXT_PUBLIC_ prefix, never sent to the browser.
# All database access goes through server code with this key (see DATABASE.md section 5).
SUPABASE_SECRET_KEY=

# Publishable key (sb_publishable_...). Not used yet: the browser never queries
# Supabase directly, and the anon role has no table access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Super admin identity (see AGENTS.md → "Super admin")
SUPER_ADMIN_PHONE=+20XXXXXXXXXX
SUPER_ADMIN_EMAIL=you@example.com
